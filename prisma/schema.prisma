generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id          String  @id @default(cuid())
  city        String
  state       String?
  country     String // ISO country name or code, your call
  countryCode String  @db.Char(2) // "IN", "US" — for filters/flags
  lat         Float?
  lng         Float?
  label       String // denormalized display string: "Meerut, UP, India"
  users       User[]

  @@unique([city, state, country])
  @@index([countryCode])
  @@index([lat, lng]) // pair with PostGIS or a bounding-box query for radius search
  @@map("location")
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  username         String?           @unique
  displayUsername  String?
  bio              String?
  headline         String?
  locationId       String?
  location         Location?         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  candidateProfile CandidateProfile?
  companyMembers   CompanyMember?
  resumes          Resume[]

  @@map("user")
}

model Resume {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  default  Boolean @default(false)
  label    String
  fileUrl  String
  fileName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CandidateProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  about        String?
  portfolioUrl String?
  linkedinUrl  String?
  githubUrl    String?
  bannerImage  String?
  skills       String[]
  isOpenToWork Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  education    Education[]
  experience   WorkExperience[]
}

model Education {
  id        String           @id @default(cuid())
  profileId String
  school    String
  degree    String
  field     String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean          @default(false)
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model WorkExperience {
  id          String           @id @default(cuid())
  profileId   String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean          @default(false)
  description String?
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Company {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  logo         String?
  banner       String?
  website      String?
  linkedin     String?
  description  Json?
  companyEmail String?
  industry     String?
  size         CompanySize     @default(SMALL)
  location     String?
  isVerified   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      CompanyMember[]
  jobs         JobPosts[]

  @@index([slug])
}

model CompanyMember {
  id         String      @id @default(cuid())
  userId     String
  companyId  String
  createdAt  DateTime    @default(now())
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRole MemberRoles
  jobPosts   JobPosts[]  @relation("PostedJobs")

  @@unique([userId, companyId])
  @@unique([userId])
  @@index([companyId])
}

model JobPosts {
  id String @id @default(cuid())

  title            String
  slug             String   @unique
  description      String   @db.Text
  responsibilities String[]
  requirements     String[]

  employmentType EmploymentType
  workMode       WorkMode
  location       String?

  minSalary Int?
  maxSalary Int?
  currency  String? @default("USD")

  experienceLevel ExperienceLevel
  skills          String[]

  status              JobPostStatus @default(DRAFT)
  applicationDeadline DateTime?

  postedById String
  postedBy   CompanyMember @relation("PostedJobs", fields: [postedById], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([postedById])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum MemberRoles {
  ADMIN
  RECRUITER
  INTERVIEWER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum JobPostStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobPostsType {
  CANDIDATE_HIRING
  RECRUITER_HIRING
  INTERVIEWER_HIRING
}
